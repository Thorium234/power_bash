import tkinter as tk
from tkinter import ttk, messagebox
from threading import Thread
from pathlib import Path
import queue
import time
import subprocess
import platform
import json
import sys

from finder import search_files
from view import FinderView
from utils import open_file, open_folder, preview_drawio, save_tabs, load_tabs

# ---------------- CONFIG ---------------- #
APP_NAME = "Smart File Finder Pro"
HOME = Path.home()
HISTORY_FILE = HOME / ".file_finder_history.json"
THEME_FILE = HOME / ".file_finder_theme.json"
MAX_HISTORY = 50

SEARCH_SCOPES = {
    "Home": HOME,
    "Desktop": HOME / "Desktop",
    "Projects": HOME / "Projects",
}

THEMES = {
    "dark": {
        "bg": "#2b2b2b",
        "fg": "#e6e6e6",
        "accent": "#4caf50",
        "canvas": "#1e1e1e"
    },
    "light": {
        "bg": "#f2f2f2",
        "fg": "#222222",
        "accent": "#007acc",
        "canvas": "#dddddd"
    }
}


# ---------------- SEARCH TASK ---------------- #
class SearchTask:
    def __init__(self, root, mode, query, out_queue):
        self.root = str(root)
        self.mode = mode
        self.query = query
        self.queue = out_queue
        self.stop_flag = [False]
        self.thread = None

    def start(self):
        self.thread = Thread(
            target=search_files,
            args=(self.root, self.mode, self.query, lambda p: self.queue.put(p), self.stop_flag),
            daemon=True,
        )
        self.thread.start()

    def cancel(self):
        self.stop_flag[0] = True

    def is_alive(self):
        return self.thread and self.thread.is_alive()


# ---------------- APP ---------------- #
class App(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title(APP_NAME)
        self.geometry("1250x750")
        self.minsize(950, 600)

        # State
        self.queue = queue.Queue()
        self.active_task = None
        self.current_tree = None
        self.history = self.load_history()
        self.theme_name = self.load_theme()
        self.theme = THEMES[self.theme_name]

        # ----------------- STYLE ----------------- #
        self.style = ttk.Style(self)
        # Use 'clam' theme to allow style changes
        self.style.theme_use("clam")
        # Configure frame styles
        self.style.configure("Finder.TFrame", background=self.theme["bg"])
        self.style.configure("Treeview", background=self.theme["bg"], fieldbackground=self.theme["bg"],
                             foreground=self.theme["fg"], rowheight=24)
        self.style.configure("Treeview.Heading", background=self.theme["accent"], foreground=self.theme["fg"])
        self.style.configure("TLabel", background=self.theme["bg"], foreground=self.theme["fg"])
        self.style.configure("TButton", background=self.theme["accent"], foreground=self.theme["fg"])
        self.style.configure("TEntry", fieldbackground=self.theme["bg"], foreground=self.theme["fg"])

        # UI
        self.view = FinderView(self)
        self.view.configure(style="Finder.TFrame")
        self.view.preview_canvas.configure(bg=self.theme["canvas"])

        # Other setup
        self.apply_theme()
        self.setup_scope_selector()
        self.setup_clock()
        self.setup_shortcuts()
        self.setup_recent_activity()

        # Bindings
        self.view.search_btn.config(command=self.start_search)
        self.view.new_tab_btn.config(command=self.new_tab)
        self.view.open_file_btn.config(command=self.open_file)
        self.view.open_folder_btn.config(command=self.open_folder)
        self.view.fav_btn.config(command=self.toggle_theme)

        self.after(50, self.process_queue)

        self.new_tab("Welcome")

    # ---------------- THEME TOGGLE ---------------- #
    def apply_theme(self):
        # Update theme colors
        self.theme = THEMES[self.theme_name]

        # Update frame styles
        self.style.configure("Finder.TFrame", background=self.theme["bg"])
        self.style.configure("Treeview", background=self.theme["bg"], fieldbackground=self.theme["bg"],
                             foreground=self.theme["fg"])
        self.style.configure("Treeview.Heading", background=self.theme["accent"], foreground=self.theme["fg"])
        self.style.configure("TLabel", background=self.theme["bg"], foreground=self.theme["fg"])
        self.style.configure("TButton", background=self.theme["accent"], foreground=self.theme["fg"])
        self.style.configure("TEntry", fieldbackground=self.theme["bg"], foreground=self.theme["fg"])

        # Canvas bg
        self.view.preview_canvas.configure(bg=self.theme["canvas"])

    def toggle_theme(self):
        self.theme_name = "light" if self.theme_name == "dark" else "dark"
        self.theme = THEMES[self.theme_name]
        self.apply_theme()
        self.save_theme()

    def setup_scope_selector(self):
        self.scope_var = tk.StringVar(value="Home")
        menu = ttk.OptionMenu(self.view, self.scope_var, "Home", *SEARCH_SCOPES.keys())
        menu.pack(anchor="w", padx=12)

    def setup_clock(self):
        self.clock = ttk.Label(self.view, font=("JetBrains Mono", 10))
        self.clock.pack(anchor="e", padx=10)
        self.update_clock()

    def update_clock(self):
        self.clock.config(text=time.strftime("%H:%M:%S"))
        self.after(1000, self.update_clock)

    def setup_shortcuts(self):
        self.bind("<Control-Return>", lambda e: self.start_search())
        self.bind("<Control-t>", lambda e: self.new_tab())
        self.bind("<Control-w>", lambda e: self.close_tab())
        self.bind("<Control-q>", lambda e: self.safe_exit())
        self.bind("<Control-l>", lambda e: self.view.entry.focus())
        self.bind("<F5>", lambda e: self.refresh_tab())
        self.bind("<Control-d>", lambda e: self.toggle_theme())

    def setup_recent_activity(self):
        self.recent_listbox = tk.Listbox(self.view, height=10)
        self.recent_listbox.pack(side="right", padx=5, fill="y")
        self.refresh_recent_activity()
        self.recent_listbox.bind("<Double-1>", self.select_recent)

    def refresh_recent_activity(self):
        self.recent_listbox.delete(0, tk.END)
        for item in self.history:
            self.recent_listbox.insert(tk.END, item)

    def select_recent(self, event):
        sel = self.recent_listbox.curselection()
        if sel:
            query = self.recent_listbox.get(sel[0])
            self.view.entry.delete(0, tk.END)
            self.view.entry.insert(0, query)
            self.start_search()

    # ---------------- TABS ---------------- #
    def new_tab(self, title="New Search"):
        frame, tree = self.view.create_tab(title)
        self.current_tree = tree
        self.view.tabs.select(frame)

    def close_tab(self):
        sel = self.view.tabs.select()
        if sel:
            if self.active_task:
                self.active_task.cancel()
            self.view.tabs.forget(sel)

    def refresh_tab(self):
        if self.current_tree:
            for item in self.current_tree.get_children():
                self.current_tree.delete(item)

    # ---------------- SEARCH ---------------- #
    def start_search(self):
        query = self.view.entry.get().strip()
        if not query:
            return

        if self.active_task:
            self.active_task.cancel()

        scope = SEARCH_SCOPES.get(self.scope_var.get(), HOME)
        self.current_tree.delete(*self.current_tree.get_children())

        self.active_task = SearchTask(scope, self.view.mode.get(), query, self.queue)
        self.save_history(query)
        self.view.progress.start()
        self.active_task.start()

    def process_queue(self):
        try:
            while True:
                path = self.queue.get_nowait()
                self.current_tree.insert("", "end", values=(path,))
        except queue.Empty:
            pass

        if self.active_task and not self.active_task.is_alive():
            self.view.progress.stop()

        self.after(50, self.process_queue)

    # ---------------- ACTIONS ---------------- #
    def selected_path(self):
        sel = self.current_tree.selection()
        if sel:
            return self.current_tree.item(sel[0])["values"][0]
        return None

    def open_file(self):
        path = self.selected_path()
        if path:
            open_file(path)
            if path.lower().endswith(".drawio"):
                preview_drawio(path, self.view.preview_canvas)

    def open_folder(self):
        path = self.selected_path()
        if path:
            open_folder(path)

    # ---------------- HISTORY ---------------- #
    def load_history(self):
        if HISTORY_FILE.exists():
            try:
                return json.loads(HISTORY_FILE.read_text())
            except Exception:
                return []
        return []

    def save_history(self, query):
        if query in self.history:
            self.history.remove(query)
        self.history.insert(0, query)
        self.history = self.history[:MAX_HISTORY]
        HISTORY_FILE.write_text(json.dumps(self.history, indent=2))
        self.refresh_recent_activity()

    def load_theme(self):
        if THEME_FILE.exists():
            try:
                return json.loads(THEME_FILE.read_text())
            except Exception:
                return "dark"
        return "dark"

    def save_theme(self):
        THEME_FILE.write_text(json.dumps(self.theme_name))

    # ---------------- EXIT ---------------- #
    def safe_exit(self):
        if self.active_task:
            self.active_task.cancel()
        self.destroy()


# ---------------- RUN ---------------- #
if __name__ == "__main__":
    try:
        App().mainloop()
    except KeyboardInterrupt:
        sys.exit(0)

